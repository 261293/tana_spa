# Copy to .env (never commit .env).

# --- Database ---
POSTGRES_DB=tana_spa
POSTGRES_PORT=5432
DATABASE_USER=tana
DATABASE_PASSWORD=tana_dev
# Used when running the server with Gradle on the host. Compose overrides it for the container.
# Leave unset to use the in-memory store (non-production only).
DATABASE_URL=jdbc:postgresql://localhost:5432/tana_spa
DATABASE_POOL_SIZE=10
# false = skip Flyway at startup (run migrations as a deploy step)
DATABASE_MIGRATE=true

# --- Server ---
APP_ENV=development
SERVER_PORT=8081
# Required when APP_ENV=production. Use 32+ random chars: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-at-least-32-chars!!
CORS_ALLOWED_ORIGINS=http://localhost:8080
# true when running behind a reverse proxy
TRUST_PROXY=false
DEFAULT_PHONE_REGION=VN

# --- Twilio Verify (OTP). Required when APP_ENV=production ---
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
