# Copy to .env (never commit .env).

# --- Database ---
POSTGRES_DB=tana_spa
POSTGRES_PORT=5432
DATABASE_USER=tana
DATABASE_PASSWORD=tana_dev
# Used when running the server with Gradle on the host. Compose overrides it for the container.
# Leave unset to use the in-memory store (non-production only).
DATABASE_URL=jdbc:postgresql://localhost:5432/tana_spa
DATABASE_POOL_SIZE=10
# false = skip Flyway at startup (run migrations as a deploy step)
DATABASE_MIGRATE=true

# --- Server ---
APP_ENV=development
# Host port that compose publishes. The server itself reads PORT (compose sets it); set PORT, not
# SERVER_PORT, when running with Gradle on a different port.
SERVER_PORT=8081
# Required when APP_ENV=production. Use 32+ random chars: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-at-least-32-chars!!
CORS_ALLOWED_ORIGINS=http://localhost:8080
# --- Seeded accounts ---
# Password of the two fixed administrators (sanghtruong@, duchnguyen@). Required in production;
# without it the server generates one per start and prints it in the log.
SEED_ADMIN_PASSWORD=
# More administrators: email|Display Name|password, separated by ;
SEED_ADMINS=
# The spa owner, who runs the booking desk. Required when APP_ENV=production.
SEED_OWNER=owner@tana.local|Jade Bathhouse|owner-dev-password

# true when running behind a reverse proxy
TRUST_PROXY=false
DEFAULT_PHONE_REGION=VN

# --- Twilio Verify (OTP). Required when APP_ENV=production ---
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Anti-abuse country policy, both optional. Comma separated ISO codes, e.g. VN,US.
# Unset/empty ALLOWED = every country; BLOCKED wins over ALLOWED.
OTP_ALLOWED_COUNTRIES=
OTP_BLOCKED_COUNTRIES=

# --- Push notifications (FCM HTTP v1). Optional: with neither set, notifications are stored
# and shown in the app but no device is woken up. See docs/notifications.md ---
# The service-account key from the Firebase console, inline (escaped newlines are fine)...
FCM_SERVICE_ACCOUNT_JSON=
# ...or a path to the same file. Either one is enough.
FCM_SERVICE_ACCOUNT_FILE=
# Only needed when the key is shared between projects; defaults to the key's own project_id.
FCM_PROJECT_ID=

# --- Feature flags ---
# Deploy defaults only: whatever operations store in the database (globally or for one user,
# through http://localhost:8081/admin/) wins over these. Unset = the state compiled into the
# FeatureFlag catalog. Accepts true/false, 1/0, yes/no, on/off. See docs/feature-flags.md.
# Phone verification ships OFF because the flow is unreliable.
# FEATURE_PHONE_OTP_VERIFICATION=false
# Notifications ship OFF until a Firebase project is configured.
# FEATURE_NOTIFICATIONS=false
