create function pg_temp.new_user(role text default 'customer', email text default null) returns uuid
language plpgsql as $$
declare
    uid uuid := gen_random_uuid();
    address text := coalesce(email, 'user-' || uid || '@test.local');
begin
    insert into auth.users (id, email, aud, role) values (uid, address, 'authenticated', 'authenticated');
    insert into public.users (id, email, full_name, role) values (uid, address, 'Test User', new_user.role);
    return uid;
end
$$;

create function pg_temp.as_user(uid uuid) returns void
language plpgsql as $$
begin
    perform set_config('request.jwt.claims', json_build_object('sub', uid, 'role', 'authenticated')::text, true);
    set local role authenticated;
end
$$;

create function pg_temp.as_anon() returns void
language plpgsql as $$
begin
    perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
    set local role anon;
end
$$;

create function pg_temp.as_postgres() returns void
language plpgsql as $$
begin
    reset role;
end
$$;
