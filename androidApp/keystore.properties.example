# Copy to androidApp/keystore.properties (gitignored) to sign local release builds.
# CI should pass the same four values as environment variables instead:
# ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD.
# The environment wins when both are present. See docs/release-signing.md.

# Path to the keystore, relative to the repository root (or absolute). Keep it outside the repo.
storeFile=../tana-upload-key.jks
storePassword=
keyAlias=upload
# Optional: defaults to storePassword, which is what `keytool -genkeypair` produces.
keyPassword=
